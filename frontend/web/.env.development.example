# 【开发】环境变量 - 覆盖通用配置（案例）

# 环境标识
VITE_APP_ENV = dev

# 项目名称
VITE_APP_TITLE = GravityD

# 后端 BaaS 提供商配置：insforge | firebase
VITE_BACKEND_PROVIDER = insforge

# 浏览器侧同源前缀（与 Vite 代理配合时用 /，请求走 localhost:端口 + 代理）
VITE_API_URL = /

# 历史 FastAPI 地址（已停用，保留字段以免旧代码读空）
VITE_API_BASE_URL = http://127.0.0.1:7130

# [BaaS] 自托管 InsForge 配置
VITE_INSFORGE_URL = http://127.0.0.1:7130
VITE_INSFORGE_ANON_KEY =

# [BaaS] Google Firebase 配置（当 VITE_BACKEND_PROVIDER = firebase 时生效）
VITE_FIREBASE_API_KEY =
VITE_FIREBASE_AUTH_DOMAIN =
VITE_FIREBASE_PROJECT_ID =
VITE_FIREBASE_STORAGE_BUCKET =
VITE_FIREBASE_MESSAGING_SENDER_ID =
VITE_FIREBASE_APP_ID =
VITE_FIREBASE_MEASUREMENT_ID =

# 是否删除控制台输出
VITE_DROP_CONSOLE = false

# WebSocket 端点（AI对话功能需要配置）
VITE_APP_WS_ENDPOINT = ws://localhost:8001

